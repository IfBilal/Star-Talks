{
  "expo": {
    "name": "Star Talks",
    "slug": "star-talks",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/star-talks-logo.png",
    "scheme": "startalks",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.startalks.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#080B46",
        "foregroundImage": "./assets/images/star-talks-logo.png",
        "monochromeImage": "./assets/images/star-talks-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/star-talks-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080B46",
          "image": "./assets/images/star-talks-lockup.png",
          "imageWidth": 240
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
