EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Public Geoapify key. Create it in the client-owned Geoapify account and set usage
# quotas/restrictions before shipping; production can proxy this through an Edge Function.
EXPO_PUBLIC_PLACES_PROVIDER=geoapify
EXPO_PUBLIC_GEOAPIFY_API_KEY=

# Enable only after WhatsApp OTP delivery and the verified-phone database gate
# are ready. Requires a new client build or update when changed.
EXPO_PUBLIC_REQUIRE_VERIFIED_PHONE=false
